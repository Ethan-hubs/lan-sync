SYNCTHING_TAG=v2.1.5
SYNCTHING_COMMIT=2ca95cf1498104113fdfde46df4107f2450a0f71

# —— ECS
ECS_HOST=<YOUR_ECS_PUBLIC_IP_OR_DOMAIN>
