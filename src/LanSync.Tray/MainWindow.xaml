<Window x:Class="LanSync.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanSync 文件同步"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="未连接" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PauseButton" Content="暂停同步" Width="100" Margin="0,0,8,0" IsEnabled="False" Click="OnPauseClick"/>
            <Button x:Name="ResumeButton" Content="恢复同步" Width="100" IsEnabled="False" Click="OnResumeClick"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="文件夹">
                <ListView x:Name="FolderList"/>
            </TabItem>
            <TabItem Header="冲突">
                <ListView x:Name="ConflictList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="路径" DisplayMemberBinding="{Binding Path=Path}" Width="360"/>
                            <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Path=Message}" Width="260"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="恢复版本">
                <TextBlock Text="版本恢复占位（阶段一只读展示）" Foreground="Gray" Margin="8" VerticalAlignment="Top"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>