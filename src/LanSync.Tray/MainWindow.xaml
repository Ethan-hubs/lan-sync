<Window x:Class="LanSync.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanSync 文件同步"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="未连接" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PauseButton" Content="暂停同步" Width="100" Margin="0,0,8,0" IsEnabled="False" Click="OnPauseClick"/>
            <Button x:Name="ResumeButton" Content="恢复同步" Width="100" IsEnabled="False" Click="OnResumeClick"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="文件夹">
                <ListView x:Name="FolderList"/>
            </TabItem>
            <TabItem Header="冲突">
                <ListView x:Name="ConflictList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="路径" DisplayMemberBinding="{Binding Path=Path}" Width="360"/>
                            <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Path=Message}" Width="260"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="恢复版本">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文件夹" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="RestoreFolderCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              DisplayMemberPath="DisplayName" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="相对路径" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="RestorePathBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="查询版本" Width="90" Margin="0,0,0,8"
                            Click="OnLoadVersionsClick"/>

                    <ListView x:Name="RestoreVersionList" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="版本时间" DisplayMemberBinding="{Binding VersionTime}" Width="180"/>
                                <GridViewColumn Header="文件时间" DisplayMemberBinding="{Binding ModTime}" Width="220"/>
                                <GridViewColumn Header="大小" DisplayMemberBinding="{Binding Size}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="RestoreResultText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                               TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <Button x:Name="RestoreButton" Grid.Row="4" Grid.Column="2" Content="恢复所选版本"
                            Width="120" IsEnabled="False" Click="OnRestoreClick"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
